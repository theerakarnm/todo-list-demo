# Copy to .dev.vars for local development. Never commit .dev.vars.
# Production values are set with `wrangler secret put <NAME>`.
# "development" logs email links when RESEND_API_KEY is empty; wrangler.jsonc sets "production" for deploys.
APP_ENV=development
# Better Auth: any long random string (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# Production sets this in wrangler.jsonc vars. Keep it empty locally: an empty value overrides it, so each request's origin is used.
BETTER_AUTH_URL=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Turnstile. Locally, Cloudflare's test keys always pass:
# site key 1x00000000000000000000AA, secret key 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Without RESEND_API_KEY, emails are not sent: the email link is logged instead.
RESEND_API_KEY=
EMAIL_FROM=no-reply@mail.eukron.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@theerakarnm.dev
