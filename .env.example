# Copy to .env and fill in real values. Never commit .env.
# Local dev reads these through .dev.vars (see .dev.vars.example).

# "development" logs auth-email links when RESEND_API_KEY is empty. Production is "production" (wrangler.jsonc).
APP_ENV=development

# Better Auth (any long random string locally)
BETTER_AUTH_SECRET=
# Public origin, e.g. https://jotlist.eukron.com. Leave empty to use the origin of each request.
BETTER_AUTH_URL=

# LINE Login (OAuth)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Cloudflare Turnstile. Locally, Cloudflare's test keys always pass:
# site key 1x00000000000000000000AA, secret key 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (auth emails). Without RESEND_API_KEY, emails are only logged (dev/tests).
RESEND_API_KEY=
EMAIL_FROM=no-reply@mail.eukron.com

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@theerakarnm.dev
