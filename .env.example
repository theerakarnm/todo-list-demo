# Copy to .env and fill in real values. Never commit .env.
# Local dev reads these through .dev.vars (see .dev.vars.example).

# Better Auth (any long random string locally)
BETTER_AUTH_SECRET=

# LINE Login (OAuth)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (auth emails). Without RESEND_API_KEY, emails are only logged (dev/tests).
RESEND_API_KEY=
EMAIL_FROM=no-reply@mail.eukron.com

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@theerakarnm.dev
