{
  // Tooling config files and the shared-code tests (they run in Node via Vitest).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": ".tsbuild/node"
  },
  "include": ["vite.config.ts", "vitest.config.ts", "drizzle.config.ts", "src/shared/**/*.test.ts"],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
