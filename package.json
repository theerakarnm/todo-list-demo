{
  "name": "jotlist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply jotlist --local",
    "db:migrate:remote": "wrangler d1 migrations apply jotlist --remote"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "i18next": "^27.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^31.0.1",
    "typescript": "^7",
    "vite": "^8.3.8",
    "vitest": "^5",
    "wrangler": "^4.162.0"
  }
}
